make_test_repo
resize 1280 800
wait_for_refresh
hold_key SUPER
hold_key LEFT_SHIFT
key F
release_key LEFT_SHIFT
release_key SUPER
wait_frames 10
screenshot improvement_22_search
click_ui repo_search_input
type "Alice"
click_ui repo_search_submit
wait_for_refresh
wait_until 15 validate async:repo_search=Done
wait_frames 10
screenshot improvement_22_results
expect_text "test_utils.cpp"
expect_text "Alice"
click_ui repo_search_result
wait_for_refresh
wait_frames 10
screenshot improvement_22_location
expect_text "tests/test_utils.cpp"
expect_text "Working tree"
validate visible_source_line:5=true
