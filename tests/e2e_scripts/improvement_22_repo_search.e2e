make_test_repo
resize 1280 800
wait_for_refresh
key CMD+SHIFT+F
wait_frames 10
screenshot improvement_22_search
click_ui repo_search_input
type "Alice"
click_ui repo_search_submit
wait_for_refresh
wait_frames 10
screenshot improvement_22_results
expect_text "test_utils.cpp"
expect_text "Alice"
click_ui repo_search_result
wait_for_refresh
wait_frames 10
screenshot improvement_22_location
expect_text "tests/test_utils.cpp"
expect_text "Working tree"
validate source_line=5
assert_ui diff_find_match hidden=false
