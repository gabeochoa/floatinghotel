# Flow: git controls are always shown — there is no hide/show toggle.
# The sync row is its buttons (Push/Pull/Fetch/Stash); there is no separate
# Sync pill in the repo header.
make_test_repo
resize 1280 720
wait_frames 10
wait_for_refresh
wait_frames 10

expect_no_text "Hide Git controls"
expect_no_text "Git controls hidden"
expect_text "Push"
expect_text "Pull"
expect_text "Fetch"
expect_text "Stash"
expect_no_text "Sync"
screenshot sidebar_controls
