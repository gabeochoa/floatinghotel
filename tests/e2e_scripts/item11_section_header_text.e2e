# Item 11: Section headers use title case without triangle character
make_test_repo
resize 1280 720
wait_for_refresh
wait_frames 10

# Triangle character (▾) should NOT be present in any section header
expect_no_text "▾"

# Headers should be title case with counts. The changes area is now split
# into review tabs; commit log header is "stack".
expect_text "To review"
expect_text "Approved"
expect_text "Untracked"
expect_text "stack"

screenshot item11_section_headers
