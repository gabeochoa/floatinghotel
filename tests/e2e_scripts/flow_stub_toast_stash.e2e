# Flow: Stash sidebar button opens the stash dialog (was a stub toast).
make_test_repo
resize 1280 720
wait_frames 5
screenshot flow_stub_toast_stash_files_navigation

# Sidebar is visible by default, showing the compact toolbar with Stash button
validate sidebar_visible=true

# Click Stash in sidebar toolbar
click_text "Stash"
wait_frames 5
expect_text "Stash Changes"
expect_text "Include untracked"
screenshot stub_toast_stash_01

# Cancel closes it without stashing
click_ui cancel_stash
wait_frames 3
expect_no_text "Include untracked"
