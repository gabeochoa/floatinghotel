# Flow: The Unstaged changes document shows every unstaged file's diff
# on one page — no clicking each file first. Selecting a file in the
# sidebar still drills into just that file, and clicking the Unstaged
# segment again returns to the all-files page.
make_test_repo
resize 1280 900
wait_frames 10
wait_for_refresh
wait_frames 10

# Open the Unstaged changes document without selecting any file.
click_ui review_unstaged_changes
wait_frames 15
wait_for_refresh
wait_frames 10
expect_no_text "Select a file or commit"
# main.cpp's modified line and README's added section both render.
expect_text "Hello, floatinghotel!"
expect_text "Development"
screenshot unstaged_all_files

# Drill into one file, then back to all files via the segment. The page
# keeps main.cpp in view, so check a file below it (src/app.cpp).
click_text "main.cpp"
wait_frames 10
expect_text "Hello, floatinghotel!"
expect_no_text "Development"
expect_no_text "modified by test setup"
click_ui review_unstaged_changes
wait_frames 15
expect_text "modified by test setup"
screenshot unstaged_all_files_again

# Leaving review mode keeps the all-files page too (this is the state
# behind the "Select a file or commit" empty prompt: the Unstaged
# changes tab active, nothing picked, not reviewing).
click_ui working_review_toggle
wait_frames 15
wait_for_refresh
wait_frames 10
expect_no_text "Select a file or commit"
expect_text "modified by test setup"
screenshot unstaged_all_files_not_reviewing
