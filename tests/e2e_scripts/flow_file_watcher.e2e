# Flow: File watcher detects external edits and auto-refreshes
make_test_repo
resize 1280 720
enable_file_watcher
wait_frames 5
click_ui sidebar_working_files
screenshot flow_file_watcher_files_navigation

# Baseline: 1 staged, 3 unstaged, 2 untracked
validate staged_count=1
validate unstaged_count=3
validate untracked_count=2
screenshot file_watcher_01_initial

# Create a new file externally — watcher should detect it.
# `wait N` is simulated ticks (sub-millisecond each in headless); the watcher's
# cooldown (1s) and FSEvents latency (0.5s) are wall clock, so gate on the event.
touch_file watcher_test.txt
wait_for_file_change
screenshot file_watcher_02_after_new_file

# Untracked count should increase by 1
validate untracked_count=3

# Modify an existing tracked file externally
touch_file README.md
wait_for_file_change
screenshot file_watcher_03_after_edit

# Unstaged count should still be 3 (README.md was already unstaged)
validate unstaged_count=3

# The new file should be visible in the sidebar (untracked files under "Untracked" tab)
click_text "Untracked"
wait_frames 5
mouse_move 130 400
scroll_wheel 0 -100
wait_frames 5
expect_text watcher_test.txt
screenshot file_watcher_04_new_file_visible
