# Flow: sticky scope header pins the enclosing symbol while scrolled.
make_test_repo
resize 1280 800
wait_for_refresh
hold_key SUPER
key P
release_key SUPER
wait_frames 5
click_ui file_picker_input
type "src/app.cpp"
wait 2
key ENTER
wait_for_refresh
wait_frames 5
key CTRL+G
wait_frames 3
type "40"
key ENTER
wait_until 15 assert_ui sticky_scope hidden=false
screenshot sticky_scrolled
