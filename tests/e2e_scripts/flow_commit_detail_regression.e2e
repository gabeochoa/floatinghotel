# Regression: commit detail view must not leave blank UI
# Verifies that clicking commits renders the commit document, switching
# commits replaces it rather than blanking, and the details popup closes.
make_test_repo
resize 1280 720
wait_frames 5
screenshot flow_commit_detail_regression_files_navigation

# Sidebar elements should be visible
expect_text "Changes"
expect_text "COMMIT HISTORY"

# Click a commit to open its document
click_text "Add contributing guidelines"
wait_for_refresh
screenshot commit_detail_regression_compact
click_ui diff_options_toggle
screenshot flow_commit_detail_options
expect_text "FILES CHANGED"
click_ui diff_options_toggle
wait_frames 3

# Details popup: subject and metadata
click_ui commit_meta_toggle
screenshot commit_detail_regression_expanded
expect_text "Add contributing guidelines"
expect_text "Commit:"
expect_text "Author:"
expect_text "Date:"

# Escape closes the popup and leaves the sidebar intact
key ESCAPE
wait_frames 5
screenshot commit_detail_regression_02_closed
expect_no_text "Commit details"
expect_text "Changes"
expect_text "COMMIT HISTORY"

# Switch to a different commit -- detail should update, not go blank
click_text "Add unit tests for utils"
wait_for_refresh
click_ui commit_meta_toggle
screenshot commit_detail_regression_03_second
expect_text "Add unit tests for utils"
expect_text "Commit:"
expect_text "Author:"
key ESCAPE
wait_frames 5

# Re-select the first commit -- must not leave blank UI
click_text "Add contributing guidelines"
wait_for_refresh
click_ui commit_meta_toggle
screenshot commit_detail_regression_04_reselect
expect_text "Add contributing guidelines"
expect_text "Commit:"
expect_text "Author:"
