# Flow: Alt+F12 type info shows in a tooltip anchored to the token (needs clangd).
make_test_repo
resize 1280 800
wait_for_refresh
hold_key 343
key P
release_key 343
wait_frames 5
click_ui file_picker_input
type "src/app.cpp"
wait 2
key ENTER
wait_for_refresh
wait_frames 5
click 490 297
wait_frames 3
key CMD+K
wait_frames 5
click_ui command_palette_input
type "Show Type"
wait_frames 5
screenshot hover_palette
key ENTER
wait_until 30 assert_ui hover_info hidden=false
screenshot hover_shown
