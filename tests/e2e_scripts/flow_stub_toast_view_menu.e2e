# The View menu's zoom items used to toast "not yet implemented". They now
# drive Theme::ui_scale, so assert the scale rather than the toast.
#
# Reset Zoom is not exercised here: it is the last item in the dropdown, and
# the last item of any dropdown does not respond to clicks (see
# docs/afterhours-gaps.md). flow_zoom.e2e covers reset via Cmd+0. The old
# version of this file asserted a toast after clicking it and passed anyway,
# because the toast from the *previous* item was still on screen.
make_test_repo
resize 1280 720
wait_frames 5
validate ui_scale=1.00

click_text "View"
wait_frames 5
click_text "Zoom In"
wait_frames 5
validate ui_scale=1.10
screenshot stub_toast_view_01_zoom_in

click_text "View"
wait_frames 5
click_text "Zoom Out"
wait_frames 5
validate ui_scale=1.00
screenshot stub_toast_view_02_zoom_out

# Twice down from the default, to show the step is not a one-shot.
click_text "View"
wait_frames 5
click_text "Zoom Out"
wait_frames 5
validate ui_scale=0.90
screenshot stub_toast_view_03_reset_zoom
