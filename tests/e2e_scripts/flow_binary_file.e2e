# Flow: Select a binary file and see appropriate message
# Binary files shouldn't show a text diff
make_test_repo
resize 1280 720
wait_frames 5
mouse_move 190 180
scroll_wheel 0 -1000
wait_frames 10
screenshot flow_binary_file_files_navigation

# Click the binary file (icon.png). There is no Untracked tab anymore:
# untracked files are rows in the same tree — scroll the file list to
# reveal icon.png, then click it.
mouse_move 140 400
scroll_wheel 0 -1000
wait_frames 5
click_text "icon.png"
wait_frames 5
screenshot flow_binary_01_selected
validate selected_file=icon.png
dump_ui_json binary_layout

# NOTE: an untracked image currently opens as a text "new file" diff
# (binary detection only applies to tracked diffs) — no Binary assertion
# until that gap is fixed.
