# Flow: Open Repository via Cmd+O. set_open_path stands in for the native
# folder panel (the test-mode consumer reads it instead of showing one).
# Asserts only the end state, so it is safe in the shared flow process.
resize 1280 720
wait_frames 10

set_open_path tests/fixture_repo
key CMD+O
wait_frames 6
wait_for_refresh
wait_frames 10
validate active_tab_label=fixture_repo (main)
screenshot open_repo_shortcut
