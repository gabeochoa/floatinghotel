resize 1280 800
wait_for_refresh
key CMD+P
screenshot improvement_26_picker
type "renamed.txt"
key ENTER
screenshot improvement_26_source
click_text "first line"
screenshot improvement_26_selected
click_ui full_file_options
wait_frames 3
click_ui "context_menu_item_Blame line 1"
wait_for_refresh
screenshot improvement_26_blame
expect_text "Original file before rename"
expect_text "original.txt:1"
click_text "Close"
screenshot improvement_26_closed
click_text "fourth line"
screenshot improvement_26_last_line
click_ui full_file_options
wait_frames 3
click_ui "context_menu_item_Blame line 4"
wait_for_refresh
screenshot improvement_26_recent_blame
expect_text "Extend renamed file"
expect_text "renamed.txt:4"
