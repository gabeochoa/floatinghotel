resize 1280 800
wait_for_refresh
key CMD+P
screenshot improvement_25_picker
type "renamed.txt"
key ENTER
screenshot improvement_25_source
click_ui full_file_options
wait_frames 3
click_ui "context_menu_item_File history"
wait_for_refresh
screenshot improvement_25_history
expect_text "History · renamed.txt · follows renames"
expect_text "Original file before rename"
expect_text "Rename the file"
click_ui file_history_commit:2
wait_frames 3
wait_for_refresh
screenshot improvement_25_original
expect_text "Original file before rename"
expect_text "original.txt"
