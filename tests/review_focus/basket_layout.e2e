make_test_repo
resize 1440 900
wait_for_refresh
click_ui sidebar_working_files
screenshot basket_files
click_text main.cpp
wait_for_refresh
screenshot basket_diff
click_ui comment_hunk_btn
wait_frames 5
screenshot basket_compose
click_ui comment_input
type "Check this change"
click_ui comment_add_btn
wait_frames 5
screenshot basket_100
validate review_unresolved=1
validate ui_in_viewport:feedback_basket=true
validate footer_fixed=true
dump_ui basket_title_100 basket_title
validate ui_height:basket_title=28.0
key CMD+EQUAL
wait_frames 2
key CMD+EQUAL
wait_frames 2
key CMD+EQUAL
wait_frames 2
key CMD+EQUAL
wait_frames 5
screenshot basket_140
validate ui_in_viewport:feedback_basket=true
validate footer_fixed=true
dump_ui basket_title_140 basket_title
validate ui_height:basket_title=39.2
resize 1100 720
wait_frames 5
screenshot basket_small
validate ui_in_viewport:feedback_basket=true
validate footer_fixed=true
click_ui basket_item_resolve
wait_frames 5
screenshot basket_resolved
validate review_unresolved=0
click_ui basket_toggle_resolved
wait_frames 5
screenshot basket_show_resolved
click_ui basket_item_edit
wait_frames 5
screenshot basket_edit
click_ui basket_edit_input
key CMD+A
type "Revised review note"
click_ui basket_edit_save
wait_frames 5
screenshot basket_saved
expect_text "Revised review note"
click_ui basket_item_resolve
wait_frames 5
validate review_unresolved=1
click_ui basket_send_btn
wait_frames 5
screenshot basket_copied
validate ui_present:toast_card=true
validate ui_present:basket_copy_btn=false
click_ui basket_close
wait_frames 5
screenshot basket_closed
validate ui_present:feedback_basket=false
validate review_unresolved=1
click_ui basket_toggle_btn
wait_frames 5
screenshot basket_reopened
validate ui_present:feedback_basket=true
resize 900 640
wait_frames 300
screenshot basket_compact
validate footer_fixed=true
