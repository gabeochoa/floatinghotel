make_test_repo
resize 1280 800
wait_for_refresh
screenshot native_menu_ready
validate native_menu=true
validate ui_present:menu_bar=false
assert_ui tab_strip y=0
assert_ui sidebar_bg y=28
click_text "Add contributing guidelines"
wait_for_refresh
screenshot native_menu_commit
native_menu_action "Larger Code Text"
wait_frames 5
screenshot native_menu_larger
validate code_font_size=17
native_menu_action "Reset Code Text"
wait_frames 5
validate code_font_size=16
native_menu_action "Copy With Location (toggle)"
wait_frames 5
screenshot native_menu_notice
validate ui_present:toast_card=true
native_menu_action "Copy With Location (toggle)"
key CMD+EQUAL
wait_frames 5
screenshot native_menu_zoom
validate ui_scale=1.10
validate footer_fixed=true
key CMD+0
native_menu_action "Toggle Sidebar"
wait_frames 5
screenshot native_menu_sidebar_hidden
validate ui_present:sidebar_bg=false
native_menu_action "Toggle Sidebar"
key CMD+T
wait_frames 5
screenshot native_menu_new_tab
validate ui_present:tab_close=true
key CMD+W
wait_frames 5
screenshot native_menu_return
validate footer_fixed=true
