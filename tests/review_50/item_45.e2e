resize 1280 800
wait_for_refresh
key CMD+P
wait_frames 3
wait_for_refresh
type "README.md"
wait_frames 3
key ENTER
wait_for_refresh
wait_frames 15
screenshot item_45_source_loaded
click_ui full_file_options
wait_frames 3
click_ui "context_menu_item_Bookmark line 1"
screenshot item_45_bookmarked
click_ui full_file_options
wait_frames 3
click_ui "context_menu_item_Preview Markdown"
wait_frames 5
assert_ui markdown_preview hidden=false
expect_text "Review notes"
expect_text "• inspect safely"
expect_text "Image omitted: remote"
expect_text "<script>alert(1)</script>"
screenshot item_45_markdown_preview
expect_no_text End of preview
mouse_move 900 500
scroll_wheel 0 -500
wait_frames 30
screenshot item_45_bottom
expect_text End of preview
expect_no_text Review notes
scroll_wheel 0 500
wait_frames 30
workspace_checkpoint 2 markdown_top
screenshot item_45_top_again
expect_text Review notes
resize 1440 900
wait_frames 10
workspace_checkpoint 2 markdown_resized
screenshot item_45_reflowed
expect_text Review notes
assert_no_overflow
pinch 0.4
wait_frames 5
mouse_move 900 500
scroll_wheel 0 -500
wait_frames 30
screenshot item_45_zoomed_bottom
expect_text End of preview
expect_no_text Review notes
validate footer_fixed=true
scroll_wheel 0 500
wait_frames 30
expect_text Review notes
key CMD+0
wait_frames 5
click_ui full_file_options
wait_frames 3
click_ui "context_menu_item_Raw Markdown"
wait_frames 3
expect_text "# Review notes"
workspace_checkpoint 2 markdown_raw
screenshot item_45_markdown_raw
click_ui full_file_options
wait_frames 3
click_ui "context_menu_item_Preview Markdown"
screenshot item_45_preview_again
click_ui full_file_options
wait_frames 3
click_ui context_menu_item_Bookmarks
wait_frames 3
click_ui "context_menu_item_README.md:L1 @ Working tree"
screenshot item_45_bookmark_source
expect_text "# Review notes"
