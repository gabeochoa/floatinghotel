resize 1440 900
wait_for_refresh
key CMD+SHIFT+F
click_ui repo_search_input
type manyneedle
click_ui repo_search_submit
wait_for_refresh
expect_text "5000 matches · limit reached"
validate search_results_bounded=true
validate search_result_count=5000
validate search_truncated=true
screenshot item_15_search_hit_cap
click_ui repo_search_input
key CMD+A
type hugeneedle
click_ui repo_search_submit
wait_for_refresh
expect_text "No matches · limit reached"
validate search_results_bounded=true
validate search_result_count=0
validate search_captured_bytes=4194304
validate search_truncated=true
screenshot item_15_search_byte_cap
