resize 1280 800
wait_for_refresh
click_text "Large expanded message"
wait_for_refresh
screenshot item_14_preview
click_ui commit_meta_toggle
screenshot item_14_expanded
expect_text "Message line 1"
expect_no_text FULL_MESSAGE_END
validate message_rows_bounded=true
mouse_move 900 400
scroll_wheel 0 -20000
wait_frames 30
screenshot item_14_end
expect_text FULL_MESSAGE_END
expect_text "File beneath the full message"
validate message_rows_bounded=true
scroll_wheel 0 20000
wait_frames 30
screenshot item_14_return
expect_text "Message line 1"
validate message_rows_bounded=true
click_ui commit_meta_toggle
screenshot item_14_collapsed
expect_no_text FULL_MESSAGE_END
