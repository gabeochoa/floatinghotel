resize 1280 800
wait_for_refresh
key CMD+P
wait_frames 3
wait_for_refresh
type "utf16.txt"
wait_frames 3
key ENTER
wait_for_refresh
wait_frames 15
click_ui full_file_options
wait_frames 3
expect_text "UTF-16 LE"
key ESCAPE
expect_text "hello utf16"
screenshot item_42_auto_utf16
click_ui full_file_options
wait_frames 3
click_ui context_menu_item_Encoding
wait_frames 3
click_ui "context_menu_item_UTF-8"
wait_for_refresh
click_ui full_file_options
wait_frames 3
expect_text "UTF-8"
key ESCAPE
click_ui full_file_options
wait_frames 3
click_ui context_menu_item_Encoding
wait_frames 3
click_ui "context_menu_item_UTF-16 LE"
wait_for_refresh
click_ui full_file_options
wait_frames 3
expect_text "UTF-16 LE"
key ESCAPE
expect_text "hello utf16"
screenshot item_42_override_utf16
resize 960 720
wait_frames 5
screenshot item_42_narrow_toolbar
assert_no_overflow
