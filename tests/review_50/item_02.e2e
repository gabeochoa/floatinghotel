click_ui file_picker_input
key CMD+A
type large.txt
key ENTER
wait_for_refresh
wait_frames 3
wait_for_refresh
wait_frames 15
screenshot item_02_source_ready
assert_ui full_file_header hidden=false
expect_text "working source"
validate file_page_content_bounded=true
validate source_page_count=1
expect_no_text "Next page"
