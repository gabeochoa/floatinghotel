validate source_page_count=2
hover_ui diff_scroll
scroll_wheel 0 -10
wait_frames 5
expect_text "second page marker"
screenshot item_02_next_page
hover_ui diff_scroll
scroll_wheel 0 20000
wait_frames 30
wait_frames 3
wait_for_refresh
expect_text "working source"
key CMD+SHIFT+F
click_ui repo_search_input
type "faraway needle"
click_ui repo_search_submit
wait_for_refresh
click_ui repo_search_result
wait_frames 3
wait_for_refresh
validate file_page_content_bounded=true
expect_text "faraway needle"
screenshot item_02_distant_line
hover_ui diff_scroll
scroll_wheel 0 -20000
wait_frames 30
