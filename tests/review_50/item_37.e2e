resize 1440 900
wait_for_refresh
key CMD+SHIFT+F
wait_frames 3
click_ui repo_search_options
click_ui repo_search_changed_only
click_ui repo_search_input
type needle
click_ui repo_search_submit
wait_for_refresh
expect_text "changed.txt"
expect_text "removed.txt"
expect_no_text "stable.txt"
screenshot item_37_changed_search
click_text "deleted needle"
wait_for_refresh
expect_text "removed.txt @"
validate source_line=1
assert_ui diff_find_match hidden=false
screenshot item_37_deleted_result
