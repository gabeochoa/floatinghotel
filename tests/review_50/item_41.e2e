resize 1280 800
wait_for_refresh
key CMD+P
wait_frames 3
wait_for_refresh
type "bookmarks.txt"
wait_frames 3
key ENTER
wait_for_refresh
wait_frames 15
click_ui full_file_options
wait_frames 3
expect_text "Bookmark line 1"
click_ui "context_menu_item_Bookmark line 1"
wait_frames 3
click_ui full_file_options
wait_frames 3
expect_text "Remove bookmark"
key ESCAPE
assert_ui bookmarks_row hidden=false
assert_ui code_bookmark hidden=false
screenshot item_41_bookmark_added
click_ui code_bookmark
wait_for_refresh
validate source_line=1
screenshot item_41_bookmark_jump
click_text beta
wait_frames 3
click_ui full_file_options
wait_frames 3
expect_text "Bookmark line 2"
click_ui "context_menu_item_Bookmark line 2"
click_text gamma
wait_frames 3
click_ui full_file_options
wait_frames 3
expect_text "Bookmark line 3"
click_ui "context_menu_item_Bookmark line 3"
click_text delta
wait_frames 3
click_ui full_file_options
wait_frames 3
expect_text "Bookmark line 4"
click_ui "context_menu_item_Bookmark line 4"
click_ui bookmarks_next
wait_frames 3
expect_text "bookmarks.txt:L4"
click_ui code_bookmark
wait_for_refresh
validate source_line=4
resize 960 720
wait_frames 5
screenshot item_41_bookmark_page
assert_no_overflow
