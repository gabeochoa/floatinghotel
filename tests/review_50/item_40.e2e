resize 1440 900
wait_for_refresh
click_text baseline
wait_for_refresh
key CMD+SHIFT+F
click_ui repo_search_input
type needle
click_ui repo_search_submit
wait_for_refresh
click_ui repo_search_preview
wait_for_refresh
expect_text "historical before"
expect_text "historical after"
expect_text "historical needle"
expect_no_text "working before"
screenshot item_40_historical_preview
click_ui repo_search_preview_close
wait_for_refresh
screenshot item_40_closed_preview
expect_text "historical before"
assert_ui repo_search_input hidden=false
click_ui repo_search_result
wait_for_refresh
expect_text "historical needle"
validate visible_source_line:2=true
validate file_page_content_bounded=true
expect_no_text "working before"
focus_ui diff_scroll
key CMD+HOME
wait_for_refresh
expect_text "historical before"
expect_no_text "working before"
screenshot item_40_open_result
