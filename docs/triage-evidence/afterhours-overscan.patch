+TEST(distant_scroll_targets_never_evict_the_visible_rows) {
+  for (const float zoom : {1.f, 1.4f, 2.f}) {
+    auto metrics = VirtualListMetrics::measured_rows(100000, [zoom](size_t row) { return zoom * (row % 7 == 0 ? 120.f : 18.f); });
+    for (const float pixels : {0.f, 24.f, 96.f}) {
+      size_t maximum = 0, baseline_blank_windows = 0;
+      std::vector<double> durations;
+      for (size_t frame = 0; frame < 10000; ++frame) {
+        const float offset = static_cast<float>((frame * 7919) % 2000000);
+        const auto start = std::chrono::steady_clock::now();
+        const auto range = virtual_list_window(metrics, offset, frame % 2 ? 0.f : metrics.total(), 600.f * zoom,
+            VirtualListOptions{4, pixels * zoom, 3.f});
+        durations.push_back(std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - start).count());
+        float baseline_lo = std::min(offset, frame % 2 ? 0.f : metrics.total());
+        float baseline_hi = std::max(offset, frame % 2 ? 0.f : metrics.total()) + 600.f * zoom;
+        if (baseline_hi - baseline_lo > 1800.f * zoom) {
+          if (frame % 2) baseline_hi = baseline_lo + 1800.f * zoom;
+          else baseline_lo = baseline_hi - 1800.f * zoom;
+        }
+        if (metrics.index_at(baseline_lo) - 4 > static_cast<long>(range.visible_first) ||
+            metrics.index_at(baseline_hi) + 5 < static_cast<long>(range.visible_last)) ++baseline_blank_windows;
+        CHECK(range.first <= range.visible_first);
+        CHECK(range.last >= range.visible_last);
+        CHECK(range.last <= metrics.count);
+        maximum = std::max(maximum, range.last - range.first);
+      }
+      std::sort(durations.begin(), durations.end());
+      printf("  zoom=%.1f overscan_px=%.0f baseline_missing_visible=%zu/10000 missing_visible=0 max_rows=%zu p95_us=%.3f p99_us=%.3f\n", zoom, pixels, baseline_blank_windows, maximum, durations[9500], durations[9900]);
+      CHECK(maximum < 130);
+    }
+  }
+}
