+
+inline VirtualListWindow virtual_list_window(const VirtualListMetrics &rows,
+                                             float offset, float target,
+                                             float viewport,
+                                             VirtualListOptions options = {}) {
+  if (rows.count == 0) return {};
+  if (!std::isfinite(viewport) || viewport <= 0.f) return {0, 1, 0, 1};
+  const float end = std::max(0.f, rows.total() - viewport);
+  offset = std::clamp(std::isfinite(offset) ? offset : 0.f, 0.f, end);
+  target = std::clamp(std::isfinite(target) ? target : offset, 0.f, end);
+  const float viewports = std::clamp(std::isfinite(options.maximum_viewports) ? options.maximum_viewports : 3.f, 1.f, 8.f);
+  target = std::clamp(target, offset - viewport * (viewports - 1.f), offset + viewport * (viewports - 1.f));
+  const float buffer = std::clamp(std::isfinite(options.overscan_pixels) ? options.overscan_pixels : 0.f, 0.f, viewport * 2.f);
+  auto index = [&](float y) { return std::min(rows.count, static_cast<size_t>(std::max(0L, rows.index_at(y)))); };
+  const auto first = index(std::min(offset, target) - buffer);
+  const auto last = std::min(rows.count, index(std::max(offset, target) + viewport + buffer) + 1);
+  const auto overscan = std::min(options.overscan_rows, size_t{256});
+  return {first > overscan ? first - overscan : 0, last + std::min(overscan, rows.count - last),
+          index(offset), std::min(rows.count, index(offset + viewport) + 1)};
+}
