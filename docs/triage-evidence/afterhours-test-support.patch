new file mode 100644
index 0000000..b8fe4c9
--- /dev/null
+++ b/tests/e2e_clipboard_test.cpp
@@ -0,0 +1,119 @@
+// e2e_clipboard_test.cpp
+// E2E runs get their own clipboard, so a script's copy/paste never reads or
+// overwrites the user's, and works with no window (the offscreen Metal runner
+// has no sokol_app clipboard at all). set_clipboard / expect_clipboard seed
+// and check it from a script.
+//
+// Built against raylib with no window: if anything still went to the system
+// clipboard here, raylib would have nothing to write to and expect_clipboard
+// would fail, so these checks cannot pass by touching the real pasteboard.
+#include "ui_test_harness.h"
+
+#include <afterhours/src/plugins/e2e_testing/runner.h>
+#include <afterhours/src/plugins/ui/text_input/component.h>
+
+#include <filesystem>
+#include <fstream>
+
+using namespace afterhours;
+using namespace afterhours::ui;
+using namespace afterhours::ui::imm;
+using namespace afterhours::testing;
+
+namespace {
+
+PendingE2ECommand run(const std::string &name, const std::string &arg) {
+  PendingE2ECommand cmd;
+  cmd.name = name;
+  cmd.args = {arg};
+  Entity dummy;
+  HandleClipboardCommands{}.for_each_with(dummy, cmd, 0.f);
+  return cmd;
+}
+
+} // namespace
+
+TEST(registering_the_handlers_isolates_the_clipboard) {
+  SystemManager sm;
+  register_builtin_handlers(sm);
+  CHECK(clipboard::detail::provider == &test_clipboard());
+  clipboard::set_text("from the app");
+  CHECK(test_clipboard().get_text() == "from the app");
+
+  use_system_clipboard();
+  CHECK(clipboard::detail::provider == nullptr);
+  isolate_clipboard();
+}
+
+TEST(set_and_expect_clipboard) {
+  isolate_clipboard();
+  test_clipboard().reset();
+  CHECK(run("set_clipboard", "héllo\nworld").succeeded());
+  CHECK(clipboard::get_text() == "héllo\nworld");
+  CHECK(run("expect_clipboard", "héllo\nworld").succeeded());
+
+  auto miss = run("expect_clipboard", "something else");
+  CHECK(!miss.succeeded());
+  CHECK(miss.error_message.find("something else") != std::string::npos);
+  CHECK(miss.error_message.find("héllo") != std::string::npos);
+}
+
+TEST(script_lines_parse_as_whole_text) {
+  const auto path = std::filesystem::temp_directory_path() /
+                    "afh_clipboard_parse.e2e";
+  std::ofstream(path) << "set_clipboard two words\n"
+                      << "expect_clipboard \"line one\\nline two\"\n";
+  const auto cmds = parse_script(path.string());
+  std::filesystem::remove(path);
+  CHECK(cmds.size() == 2);
+  CHECK(cmds.size() == 2 && cmds[0].args ==
+                                std::vector<std::string>{"two words"});
+  CHECK(cmds.size() == 2 && cmds[1].args ==
+                                std::vector<std::string>{"line one\nline two"});
+}
+
+TEST(text_input_copy_and_paste_use_the_isolated_clipboard) {
+  isolate_clipboard();
+  test_clipboard().reset();
+  ui_test::ImmTestHarness h;
+  std::string value = "copied text";
+  auto emit = [&]() -> Entity & {
+    h.begin_frame();
+    auto result = imm::text_input(
+        h.context(), mk(h.root(), 0), value,
+        ComponentConfig{}.with_size({pixels(300), pixels(40)}));
+    h.layout_only();
+    return result.ent();
+  };
+  Entity &entity = emit();
+  h.context().set_focus(entity.id);
+  emit();
+  h.context().last_action = ui_test::TestInputAction::TextSelectAll;
+  emit();
+  h.context().last_action = ui_test::TestInputAction::TextCopy;
+  emit();
+  CHECK(run("expect_clipboard", "copied text").succeeded());
+
+  run("set_clipboard", "pasted");
+  h.context().last_action = ui_test::TestInputAction::TextSelectAll;
+  emit();
+  h.context().last_action = ui_test::TestInputAction::TextPaste;
+  emit();
+  CHECK(value == "pasted");
+}
+
+TEST(reset_test_state_empties_it) {
+  isolate_clipboard();
+  run("set_clipboard", "left over");
+  PendingE2ECommand reset;
+  reset.name = "reset_test_state";
+  Entity dummy;
+  HandleResetTestStateCommand{}.for_each_with(dummy, reset, 0.f);
+  CHECK(test_clipboard().get_text().empty());
+}
+
+int main() {
+  const int rc = ui_test::run_registered_tests("E2E clipboard");
+  use_system_clipboard();
+  return rc;
+}
diff --git a/tests/e2e_unicode_type_test.cpp b/tests/e2e_unicode_type_test.cpp
new file mode 100644
index 0000000..42de1a4
--- /dev/null
+++ b/tests/e2e_unicode_type_test.cpp
@@ -0,0 +1,120 @@
+// e2e_unicode_type_test.cpp
+// `type` accepts UTF-8 and delivers one Unicode code point per character, the
+// same contract as GetCharPressed / sokol's char event.
+//
+// The injected queue stored `char`, so `type "é"` arrived as two negative
+// bytes; text fields dropped them (key > 0 ends the read loop) and nothing
+// international could be typed in a test. Built with raylib and
+// AFTER_HOURS_ENABLE_E2E_TESTING, as text_area_test is, so the injected
+// queue is what input::get_char_pressed actually reads.
+#include "ui_test_harness.h"
+
+#include <afterhours/src/plugins/ui/text_input/component.h>
+#include <afterhours/src/plugins/ui/text_input/text_area.h>
+
+#include <string>
+#include <vector>
+
+using namespace afterhours;
+using namespace afterhours::ui;
+using namespace afterhours::ui::imm;
+using namespace afterhours::testing;
+using ui_test::ImmTestHarness;
+
+namespace {
+
+const std::string kSample = "héllo 日本 🎉 ok";
+
+std::vector<int> drain() {
+  std::vector<int> out;
+  for (int c = test_input::get_char_pressed([] { return 0; }); c > 0;
+       c = test_input::get_char_pressed([] { return 0; }))
+    out.push_back(c);
+  return out;
+}
+
+void type(const std::string &text) {
+  PendingE2ECommand cmd;
+  cmd.name = "type";
+  cmd.args = {text};
+  Entity dummy;
+  HandleTypeCommand{}.for_each_with(dummy, cmd, 0.f);
+  CHECK(cmd.is_consumed() && cmd.succeeded());
+}
+
+template <typename Emit>
+std::string type_into(Emit emit, const char *field_name,
+                      const std::string &typed) {
+  ImmTestHarness h;
+  std::string value;
+  h.begin_frame();
+  emit(h, value);
+  h.layout_only();
+  if (UIComponent *f = h.find(field_name)) h.context().focus_id = f->id;
+  test_input::detail::test_mode = true;
+  input_injector::reset_all();
+  type(typed);
+  h.begin_frame();
+  emit(h, value);
+  h.layout_only();
+  test_input::reset_all();
+  test_input::detail::test_mode = false;
+  return value;
+}
+
+} // namespace
+
+TEST(push_text_decodes_utf8_to_code_points) {
+  test_input::detail::test_mode = true;
+  test_input::reset_all();
+  test_input::push_text("aé日🎉");
+  CHECK((drain() == std::vector<int>{'a', 0xE9, 0x65E5, 0x1F389}));
+
+  // Malformed input becomes U+FFFD per bad byte rather than vanishing or
+  // swallowing what follows it.
+  test_input::push_text("\xFF" "x");
+  CHECK((drain() == std::vector<int>{0xFFFD, 'x'}));
+  test_input::push_text("\xE6\x97");  // truncated 3-byte sequence
+  CHECK((drain() == std::vector<int>{0xFFFD, 0xFFFD}));
+  test_input::push_text("\xC0\xAF");  // overlong '/'
+  CHECK((drain() == std::vector<int>{0xFFFD, 0xFFFD}));
+  test_input::push_text("\xED\xA0\x80");  // UTF-16 surrogate
+  CHECK((drain() == std::vector<int>{0xFFFD, 0xFFFD, 0xFFFD}));
+  test_input::detail::test_mode = false;
+}
+
+TEST(type_command_queues_code_points_not_bytes) {
+  test_input::detail::test_mode = true;
+  test_input::reset_all();
+  type("é");
+  const auto got = drain();
+  CHECK(got.size() == 1);
+  CHECK(!got.empty() && got[0] == 0xE9);
+  test_input::detail::test_mode = false;
+}
+
+TEST(type_reaches_a_text_input_intact) {
+  const std::string value = type_into(
+      [](ImmTestHarness &h, std::string &v) {
+        imm::text_input(h.context(), mk(h.root(), 0), v,
+                        ComponentConfig{}.with_size(
+                            ComponentSize{pixels(400), pixels(40)}));
+      },
+      "text_input_field", kSample);
+  CHECK(value == kSample);
+  if (value != kSample) printf("      got '%s'\n", value.c_str());
+}
+
+TEST(type_reaches_a_text_area_intact) {
+  const std::string value = type_into(
+      [](ImmTestHarness &h, std::string &v) {
+        imm::text_area(h.context(), mk(h.root(), 0), v,
+                       ComponentConfig{}.with_size(
+                           ComponentSize{pixels(400), pixels(200)}));
+      },
+      "text_area_field", kSample);
+  CHECK(value == kSample);
+  if (value != kSample) printf("      got '%s'\n", value.c_str());
+}
+
+int main() { return ui_test::run_registered_tests("E2E unicode type"); }
diff --git a/tests/e2e_visibility_test.cpp b/tests/e2e_visibility_test.cpp
new file mode 100644
index 0000000..11a8518
--- /dev/null
+++ b/tests/e2e_visibility_test.cpp
@@ -0,0 +1,186 @@
+// e2e_visibility_test.cpp
+// E2E targets resolve to the part of an element that is actually on screen.
+//
+// A row inside a scroll view inside another scroll view has to accumulate
+// both offsets, and then be cut by both viewports. was_rendered_to_screen
+// stays true for a row scrolled out of view, so click_ui used to click the
+// centre of an invisible row and land on whatever was drawn there instead.
+#include "ui_test_harness.h"
+
+using namespace afterhours;
+using namespace afterhours::ui;
+using namespace afterhours::ui::imm;
+using namespace afterhours::testing;
+using namespace afterhours::testing::ui_commands;
+using ui_test::ImmTestHarness;
+using ui_test::TestInputAction;
+
+namespace {
+
+constexpr float ROW_H = 20.f;
+
+// outer: 300x200 scroll view at the origin, scrolled 30
+//   header: 40 tall
+//   inner: 300x100 scroll view, scrolled 50
+//     row_0..row_19, each 20 tall, labelled "label N"
+// So the inner viewport is on screen at y 10..110, and row k is drawn at
+// y = 40 - 30 + 20k - 50 = 20k - 40.
+struct NestedScroll {
+  ImmTestHarness h;
+
+  NestedScroll() {
+    h.begin_frame();
+    auto &ctx = h.context();
+    auto outer = imm::div(
+        ctx, imm::mk(h.root(), 0),
+        ComponentConfig{}
+            .with_size(ComponentSize{pixels(300.f), pixels(200.f)})
+            .with_overflow(Overflow::Scroll, Axis::Y)
+            .with_flex_direction(FlexDirection::Column)
+            .with_debug_name("outer"));
+    imm::div(ctx, imm::mk(outer.ent(), 0),
+             ComponentConfig{}
+                 .with_size(ComponentSize{pixels(300.f), pixels(40.f)})
+                 .with_debug_name("header"));
+    auto inner = imm::div(
+        ctx, imm::mk(outer.ent(), 1),
+        ComponentConfig{}
+            .with_size(ComponentSize{pixels(300.f), pixels(100.f)})
+            .with_overflow(Overflow::Scroll, Axis::Y)
+            .with_flex_direction(FlexDirection::Column)
+            .with_debug_name("inner"));
+    for (int i = 0; i < 20; ++i)
+      imm::div(ctx, imm::mk(inner.ent(), i),
+               ComponentConfig{}
+                   .with_size(ComponentSize{pixels(300.f), pixels(ROW_H)})
+                   .with_label("label " + std::to_string(i))
+                   .with_debug_name("row_" + std::to_string(i)));
+    h.layout_only();
+    outer.ent().get<HasScrollView>().scroll_offset = {0.f, 30.f};
+    inner.ent().get<HasScrollView>().scroll_offset = {0.f, 50.f};
+    test_input::reset_all();
+  }
+  ~NestedScroll() { test_input::reset_all(); }
+
+  Entity &row(int i) {
+    for (const auto &e : h.coll.get_entities())
+      if (e && e->has<UIComponentDebug>() &&
+          e->get<UIComponentDebug>().name() == "row_" + std::to_string(i))
+        return *e;
+    static Entity none;
+    return none;
+  }
+
+  template <typename Handler>
+  PendingE2ECommand run(const std::string &name,
+                        std::vector<std::string> args) {
+    PendingE2ECommand cmd;
+    cmd.name = name;
+    cmd.args = std::move(args);
+    Handler handler;
+    handler.for_each_with(row(0), cmd, 0.f);
+    return cmd;
+  }
+};
+
+bool contains(const std::string &s, const std::string &needle) {
+  return s.find(needle) != std::string::npos;
+}
+
+} // namespace
+
+TEST(screen_rect_accumulates_every_ancestor_scroll) {
+  NestedScroll f;
+  for (int k : {0, 2, 5, 7}) {
+    const RectangleType r = get_screen_rect(f.row(k));
+    CHECK_APPROX(r.y, 20.f * k - 40.f);
+    CHECK_APPROX(r.height, ROW_H);
+  }
+}
+
+TEST(visible_rect_is_cut_by_both_viewports) {
+  NestedScroll f;
+  CHECK(!is_visible(f.row(0)));  // y -40..-20, above both viewports
+  CHECK(!is_visible(f.row(1)));  // y -20..0, above the inner viewport
+  CHECK(is_visible(f.row(2)));   // y 0..20, bottom half shows
+  CHECK_APPROX(get_visible_rect(f.row(2)).y, 10.f);
+  CHECK_APPROX(get_visible_rect(f.row(2)).height, 10.f);
+  CHECK_APPROX(get_visible_rect(f.row(5)).y, 60.f);
+  CHECK_APPROX(get_visible_rect(f.row(5)).height, ROW_H);
+  CHECK_APPROX(get_visible_rect(f.row(7)).height, 10.f);  // 100..110
+  CHECK(!is_visible(f.row(8)));  // y 120..140, below the inner viewport
+
+  // The same rectangle real hit-testing uses, so a scripted click and a
+  // real one agree about what is under the pointer.
+  Entity &partial = f.row(2);
+  const RectangleType hit =
+      ui::detail::hit_rect(partial, partial.get<UIComponent>());
+  CHECK_APPROX(hit.y, get_visible_rect(partial).y);
+  CHECK_APPROX(hit.height, get_visible_rect(partial).height);
+}
+
+TEST(click_ui_aims_at_the_visible_portion) {
+  NestedScroll f;
+  auto cmd =
+      f.run<HandleClickUICommand<TestInputAction>>("click_ui", {"row_2"});
+  CHECK(cmd.is_consumed() && cmd.succeeded());
+  // The full-rect centre (y 10) sits on the clip edge; the visible centre
+  // is y 15.
+  CHECK_APPROX(input_injector::detail::mouse.pos.y, 15.f);
+}
+
+TEST(click_commands_fail_on_a_fully_clipped_target) {
+  NestedScroll f;
+  auto by_name =
+      f.run<HandleClickUICommand<TestInputAction>>("click_ui", {"row_0"});
+  CHECK(!by_name.succeeded());
+  CHECK(contains(by_name.error_message, "fully clipped"));
+  CHECK(contains(by_name.error_message, "row_0"));
+
+  auto by_text = f.run<HandleClickTextCommand<TestInputAction>>(
+      "click_text", {"label 8"});
+  CHECK(!by_text.succeeded());
+  CHECK(contains(by_text.error_message, "fully clipped"));
+
+  auto right = f.run<HandleRightClickUICommand<TestInputAction>>(
+      "right_click_ui", {"row_1"});
+  CHECK(!right.succeeded());
+
+  auto dbl = f.run<HandleMultiClickUICommand<TestInputAction, 2>>(
+      "double_click_ui", {"row_0", "center", "center"});
+  CHECK(!dbl.succeeded());
+  CHECK(contains(dbl.error_message, "clipped"));
+
+  // An absent target still says "not found", not "clipped".
+  auto missing =
+      f.run<HandleClickUICommand<TestInputAction>>("click_ui", {"row_99"});
+  CHECK(contains(missing.error_message, "not found"));
+  CHECK(input_injector::detail::mouse.left_down == false);
+}
+
+TEST(assert_ui_reports_visibility_and_the_visible_rect) {
+  NestedScroll f;
+  CHECK(check_ui_property(f.row(0), "visible", "false").empty());
+  CHECK(check_ui_property(f.row(5), "visible", "true").empty());
+  CHECK(!check_ui_property(f.row(0), "visible", "true").empty());
+  CHECK(check_ui_property(f.row(2), "vy", "10").empty());
+  CHECK(check_ui_property(f.row(2), "vh", "10").empty());
+  CHECK(check_ui_property(f.row(2), "y", "0").empty());
+  CHECK(check_ui_property(f.row(2), "h", "20").empty());
+}
+
+TEST(dump_ui_marks_clipped_nodes_only) {
+  NestedScroll f;
+  std::string out;
+  dump_ui_node(out, f.row(0), 0);
+  CHECK(contains(out, "visible=\"false\""));
+  out.clear();
+  dump_ui_node(out, f.row(2), 0);
+  CHECK(contains(out, "visible=\"partial\""));
+  CHECK(contains(out, "vy=\"10\" vw=\"300\" vh=\"10\""));
+  out.clear();
+  dump_ui_node(out, f.row(5), 0);
+  CHECK(!contains(out, "visible="));
+}
+
+int main() { return ui_test::run_registered_tests("E2E clipped visibility"); }
diff --git a/tests/e2e_zoom_coordinates_test.cpp b/tests/e2e_zoom_coordinates_test.cpp
new file mode 100644
index 0000000..c1576d8
--- /dev/null
+++ b/tests/e2e_zoom_coordinates_test.cpp
@@ -0,0 +1,127 @@
+// e2e_zoom_coordinates_test.cpp
+// E2E coordinates are logical pixels at every UI scale.
+//
+// Adaptive scaling multiplies layout by ui_scale, so a widget written as
+// 100x30 at y 40 is 140x42 at y 56 on screen at 140%. Scripts used to read
+// and write screen pixels, so every coordinate and every assert_ui went stale
+// the moment the user zoomed. Here the same script lines hold at 1.0, 1.4 and
+// 2.0, and the screen rect is checked too, so the scale really applied.
+#include "ui_test_harness.h"
+
+using namespace afterhours;
+using namespace afterhours::ui;
+using namespace afterhours::ui::imm;
+using namespace afterhours::testing;
+using namespace afterhours::testing::ui_commands;
+using ui_test::ImmTestHarness;
+using ui_test::TestInputAction;
+
+namespace {
+
+struct ScaleScope {
+  Theme saved = ThemeDefaults::get().theme;
+  ScalingMode saved_mode = UIStylingDefaults::get().scaling_mode;
+  ScaleScope(float scale, ScalingMode mode) {
+    Theme t = saved;
+    t.ui_scale = scale;
+    ThemeDefaults::get().set_theme(t);
+    UIStylingDefaults::get().scaling_mode = mode;
+  }
+  ~ScaleScope() {
+    ThemeDefaults::get().set_theme(saved);
+    UIStylingDefaults::get().scaling_mode = saved_mode;
+  }
+};
+
+// A 40-tall spacer, then "target" at logical (0,40) 100x30.
+Entity &build(ImmTestHarness &h, float scale) {
+  h.begin_frame();
+  auto &ctx = h.context();
+  auto col = imm::div(ctx, imm::mk(h.root(), 0),
+                      ComponentConfig{}
+                          .with_size(ComponentSize{pixels(400.f), pixels(300.f)})
+                          .with_flex_direction(FlexDirection::Column));
+  imm::div(ctx, imm::mk(col.ent(), 0),
+           ComponentConfig{}.with_size(
+               ComponentSize{pixels(100.f), pixels(40.f)}));
+  auto target = imm::div(ctx, imm::mk(col.ent(), 1),
+                         ComponentConfig{}
+                             .with_size(ComponentSize{pixels(100.f),
+                                                      pixels(30.f)})
+                             .with_debug_name("target"));
+  h.layout_only(false, {800, 600}, scale);
+  return target.ent();
+}
+
+PendingE2ECommand run(System<PendingE2ECommand> &&handler, Entity &e,
+                      const std::string &name, std::vector<std::string> args) {
+  PendingE2ECommand cmd;
+  cmd.name = name;
+  cmd.args = std::move(args);
+  handler.for_each_with(e, cmd, 0.f);
+  return cmd;
+}
+
+} // namespace
+
+TEST(coordinates_are_logical_at_every_scale) {
+  for (float scale : {1.0f, 1.4f, 2.0f}) {
+    printf("    scale %.1f\n", scale);
+    ScaleScope scope(scale, ScalingMode::Adaptive);
+    ImmTestHarness h;
+    Entity &target = build(h, scale);
+    test_input::reset_all();
+
+    // Not vacuous: on screen the widget really did scale.
+    const RectangleType screen = get_screen_rect(target);
+    CHECK_APPROX(screen.y, 40.f * scale);
+    CHECK_APPROX(screen.height, 30.f * scale);
+    CHECK_APPROX(e2e_ui_scale(), scale);
+
+    // Reports: the same numbers at every scale.
+    for (const char *prop : {"x=0", "y=40", "w=100", "h=30", "vy=40", "vh=30"}) {
+      std::string p, v;
+      parse_prop_assertion(prop, p, v);
+      const std::string err = check_ui_property(target, p, v);
+      CHECK(err.empty());
+      if (!err.empty()) printf("      %s\n", err.c_str());
+    }
+    std::string xml;
+    dump_ui_node(xml, target, 0);
+    CHECK(xml.find("x=\"0\" y=\"40\" w=\"100\" h=\"30\"") != std::string::npos);
+
+    // Input: a logical point lands inside the widget's screen rect.
+    auto click = run(HandleClickCommand{}, target, "click", {"50", "55"});
+    CHECK(click.succeeded());
+    const auto &m = input_injector::detail::mouse;
+    CHECK_APPROX(m.pos.x, 50.f * scale);
+    CHECK_APPROX(m.pos.y, 55.f * scale);
+    CHECK(m.pos.y > screen.y && m.pos.y < screen.y + screen.height);
+
+    // Percentages stay fractions of the window.
+    run(HandleMouseMoveCommand{}, target, "mouse_move", {"50%", "50%"});
+    const auto [sw, sh] = e2e_screen_size();
+    CHECK_APPROX(m.pos.x, sw / 2);
+    CHECK_APPROX(m.pos.y, sh / 2);
+
+    // Offsets from a named element are logical too.
+    multi_click_ui_detail::reset();
+    run(HandleMultiClickUICommand<TestInputAction, 2>{}, target,
+        "double_click_ui", {"target", "10", "5"});
+    CHECK_APPROX(m.pos.x, screen.x + 10.f * scale);
+    CHECK_APPROX(m.pos.y, screen.y + 5.f * scale);
+    multi_click_ui_detail::reset();
+    test_input::reset_all();
+  }
+}
+
+TEST(proportional_mode_ignores_ui_scale_like_layout_does) {
+  ScaleScope scope(2.0f, ScalingMode::Proportional);
+  ImmTestHarness h;
+  Entity &target = build(h, 2.0f);
+  CHECK_APPROX(e2e_ui_scale(), 1.f);
+  CHECK_APPROX(get_screen_rect(target).height, 30.f);
+  CHECK(check_ui_property(target, "h", "30").empty());
+}
+
+int main() { return ui_test::run_registered_tests("E2E zoom coordinates"); }
diff --git a/tests/files_isolated_storage_test.cpp b/tests/files_isolated_storage_test.cpp
new file mode 100644
index 0000000..71552c1
--- /dev/null
+++ b/tests/files_isolated_storage_test.cpp
@@ -0,0 +1,116 @@
+// files_isolated_storage_test.cpp
+// AFTERHOURS_TEST_STORAGE_DIR and files::isolate_storage put config, saves
+// and temp under one test root. Apps were redirecting config and forgetting
+// saves, and fixture records landed in the user's real save folder.
+//
+// HOME (and XDG_*) point at a scratch dir, so the platform-folder lookup this
+// test is guarding against can only ever touch that scratch dir.
+
+#include <afterhours/src/plugins/files.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <string>
+#include <unistd.h>
+
+namespace fs = std::filesystem;
+using afterhours::files;
+using ProvidesResourcePaths = afterhours::files::ProvidesResourcePaths;
+
+static int checks_run = 0;
+static int checks_passed = 0;
+
+static void check(bool cond, const std::string &what) {
+  checks_run++;
+  if (cond) {
+    checks_passed++;
+  } else {
+    fprintf(stderr, "  FAIL: %s\n", what.c_str());
+  }
+}
+
+static bool under(const fs::path &p, const fs::path &root) {
+  const auto rel = fs::weakly_canonical(p).lexically_relative(
+      fs::weakly_canonical(root));
+  return !rel.empty() && *rel.begin() != "..";
+}
+
+int main() {
+  printf("=== files isolated storage ===\n\n");
+  std::error_code ec;
+  const fs::path scratch = fs::temp_directory_path() /
+                           ("afh_storage_" + std::to_string(getpid()));
+  fs::remove_all(scratch, ec);
+  const fs::path home = scratch / "home";
+  const fs::path root = scratch / "test-root";
+  fs::create_directories(home);
+  setenv("HOME", home.c_str(), 1);
+  for (const char *xdg : {"XDG_CONFIG_HOME", "XDG_DATA_HOME", "XDG_STATE_HOME",
+                          "XDG_CACHE_HOME"})
+    unsetenv(xdg);
+
+  // Control: without isolation the constructor creates the platform save
+  // folder, which is what the isolated case must not do.
+  unsetenv(files::TEST_STORAGE_ENV);
+  {
+    ProvidesResourcePaths real("isogame", "resources");
+    check(under(real.save_folder_path, home),
+          "control: platform save folder resolves under HOME");
+    check(fs::exists(real.save_folder_path),
+          "control: and the constructor creates it");
+    check(!real.temp_folder_path.empty(),
+          "control: temp has a default outside the test root");
+  }
+  fs::remove_all(home, ec);
+  fs::create_directories(home);
+
+  setenv(files::TEST_STORAGE_ENV, root.c_str(), 1);
+  {
+    ProvidesResourcePaths p("isogame", "resources");
+    check(p.config_folder_path == root / "config" / "isogame",
+          "config goes to <root>/config/<game>");
+    check(p.save_folder_path == root / "save" / "isogame",
+          "saves go to <root>/save/<game>");
+    check(p.temp_folder_path == root / "tmp" / "isogame",
+          "temp goes to <root>/tmp/<game>");
+    for (const fs::path &d :
+         {p.config_folder_path, p.save_folder_path, p.temp_folder_path})
+      check(fs::is_directory(d), "created " + d.string());
+    check(fs::is_empty(home),
+          "nothing under HOME was created, so real folders are untouched");
+  }
+  unsetenv(files::TEST_STORAGE_ENV);
+
+  // After init: the host learned its test dir from argv.
+  {
+    afterhours::EntityCollection coll;
+    afterhours::EntityHelper::set_default_collection(&coll);
+    const fs::path late = scratch / "late-root";
+    check(!files::isolate_storage(late),
+          "isolate_storage reports failure before init");
+    files::init("lategame");
+    check(files::isolate_storage(late), "isolate_storage succeeds after init");
+    check(files::get_config_path() == late / "config" / "lategame",
+          "config redirected");
+    check(files::get_save_path() == late / "save" / "lategame",
+          "saves redirected with it");
+    check(files::get_temp_path() == late / "tmp" / "lategame",
+          "temp redirected with it");
+    check(files::write_string_atomic(files::get_save_path() / "slot.json",
+                                     "{}"),
+          "a save lands");
+    check(fs::exists(late / "save" / "lategame" / "slot.json"),
+          "inside the test root");
+    afterhours::EntityHelper::set_default_collection(nullptr);
+  }
+
+  fs::remove_all(scratch, ec);
+  printf("\n%d/%d checks passed\n", checks_passed, checks_run);
+  if (checks_passed != checks_run) {
+    printf("FAILURES: %d\n", checks_run - checks_passed);
+    return 1;
+  }
+  printf("All checks passed!\n");
+  return 0;
+}
diff --git a/tests/native_resize_test.cpp b/tests/native_resize_test.cpp
new file mode 100644
index 0000000..c48808c
--- /dev/null
+++ b/tests/native_resize_test.cpp
@@ -0,0 +1,116 @@
+// native_resize_test.cpp
+// `native_resize w h` resizes the real window and holds the script until the
+// backend reports that size and a UI render has followed; headless gets an
+// explicit "unsupported" instead of a pass on a size nobody drew.
+//
+// No args: the headless check only, safe for `make test`.
+// --window: also opens a hidden raylib (GLFW/Cocoa) window and drives the
+// resize for real. Needs a window server, so it runs from
+// `make native-window-test`, not from `make test`.
+#include "ui_test_harness.h"
+
+#include <afterhours/src/plugins/e2e_testing/runner.h>
+
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <string>
+
+using namespace afterhours;
+using namespace afterhours::testing;
+
+namespace {
+
+bool g_window = false;
+
+PendingE2ECommand resize_once(const std::vector<std::string> &args) {
+  PendingE2ECommand cmd;
+  cmd.name = "native_resize";
+  cmd.args = args;
+  Entity dummy;
+  HandleNativeResizeCommand{}.for_each_with(dummy, cmd, 0.f);
+  return cmd;
+}
+
+} // namespace
+
+TEST(headless_reports_unsupported) {
+  graphics::raylib_backend::ensure_registered();
+  graphics::raylib_backend::storage() = graphics::RaylibHeadless{};
+  CHECK(graphics::is_headless());
+  auto cmd = resize_once({"640", "480"});
+  CHECK(cmd.is_consumed() && !cmd.succeeded());
+  CHECK(cmd.error_message.find("unsupported in headless mode") !=
+        std::string::npos);
+  graphics::raylib_backend::storage() = std::monostate{};
+}
+
+TEST(window_resize_waits_for_the_drawable) {
+  if (!g_window) {
+    printf("    (skipped: pass --window; needs a window server)\n");
+    return;
+  }
+  raylib::SetTraceLogLevel(raylib::LOG_WARNING);
+  raylib::SetConfigFlags(raylib::FLAG_WINDOW_HIDDEN);
+  raylib::InitWindow(400, 300, "native_resize_test");
+  CHECK(raylib::IsWindowReady());
+  if (!raylib::IsWindowReady()) return;
+
+  EntityCollection coll;
+  EntityHelper::set_default_collection(&coll);
+  reset_command_error_count();
+  const auto script =
+      std::filesystem::temp_directory_path() / "afh_native_resize.e2e";
+  std::ofstream(script) << "native_resize 640 480 5\nmouse_move 1 1\n";
+  E2ERunner runner;
+  runner.load_script(script.string());
+
+  HandleNativeResizeCommand resize;
+  HandleMouseMoveCommand move;
+  E2ECommandCleanupSystem cleanup;
+  int renders_before_done = 0;
+  bool resize_done = false, move_seen_before_done = false;
+  const auto start = std::chrono::steady_clock::now();
+  for (int frame = 0; frame < 600 && !runner.is_finished(); ++frame) {
+    runner.tick(1.f / 60.f);
+    coll.merge_entity_arrays();
+    for (const auto &e : coll.get_entities()) {
+      if (!e || !e->has<PendingE2ECommand>()) continue;
+      auto &cmd = e->get<PendingE2ECommand>();
+      if (cmd.is("mouse_move") && !resize_done) move_seen_before_done = true;
+      resize.for_each_with(*e, cmd, 0.f);
+      if (cmd.is("native_resize") && cmd.is_consumed())
+        resize_done = cmd.succeeded();
+      move.for_each_with(*e, cmd, 0.f);
+      cleanup.for_each_with(*e, cmd, 0.f);
+    }
+    coll.cleanup();
+    // The UI render pass: draw, present, then the registry generation the
+    // barrier counts.
+    raylib::BeginDrawing();
+    raylib::ClearBackground(raylib::DARKGRAY);
+    raylib::EndDrawing();
+    VisibleTextRegistry::instance().clear();
+    if (!resize_done) ++renders_before_done;
+  }
+  const double ms = std::chrono::duration<double, std::milli>(
+                        std::chrono::steady_clock::now() - start)
+                        .count();
+  printf("    window %dx%d (render %dx%d), %d renders, %.1f ms\n",
+         raylib::GetScreenWidth(), raylib::GetScreenHeight(),
+         raylib::GetRenderWidth(), raylib::GetRenderHeight(),
+         renders_before_done, ms);
+  CHECK(resize_done);
+  CHECK(runner.is_finished() && !runner.has_failed());
+  CHECK(raylib::GetScreenWidth() == 640 && raylib::GetScreenHeight() == 480);
+  CHECK(!move_seen_before_done);  // the script was held behind the resize
+  std::filesystem::remove(script);
+  EntityHelper::set_default_collection(nullptr);
+  raylib::CloseWindow();
+}
+
+int main(int argc, char **argv) {
+  for (int i = 1; i < argc; ++i)
+    if (std::string(argv[i]) == "--window") g_window = true;
+  return ui_test::run_registered_tests("native_resize");
+}
