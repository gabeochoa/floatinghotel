 src/plugins/ui/scroll_item_anchor.h | 127 +++++++++++++++++++
 src/plugins/ui/systems.h            |   4 +
 tests/Makefile                      |   4 +-
 tests/scroll_item_anchor_test.cpp   | 184 ++++++++++++++++++++++++++++
 5 files changed, 327 insertions(+), 1 deletion(-)
 create mode 100644 src/plugins/ui/scroll_item_anchor.h
 create mode 100644 tests/scroll_item_anchor_test.cpp

