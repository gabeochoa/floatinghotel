wait_frames 3
click_ui compare_base
key CMD+A
type "665b79e84be8b32e6c945aa581e68e6bd77292da"
click_ui compare_target
key CMD+A
type "82e6bc12e5c45a0ddc9dd3252876c5b9773933ad"
click_ui compare_submit
wait_for_refresh
wait_frames 20
click_ui open_full_file
wait_for_refresh
wait_frames 20
workspace_checkpoint 3 source
screenshot source
key CMD+SHIFT+F
wait_frames 3
click_ui repo_search_options
click_ui repo_search_changed_only
click_ui repo_search_input
type "NEEDLE"
key ENTER
wait_for_refresh
wait_frames 20
